{
  "name": "fomo-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env.server --watch server/index.ts",
    "start": "node --env-file-if-exists=.env.server server/index.ts",
    "build": "npm run typecheck && vite build && node scripts/check-client-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.app.json && tsc --project tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:claude": "node integration/run-claude-federation.ts",
    "lint": "eslint . --max-warnings 0",
    "audit": "npm audit --audit-level=low",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
