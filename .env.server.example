# Copy to .env.server for local overrides; npm start and dev:server load it.
# Static mode works locally without credentials.
AI_ENABLED=false
CLAUDE_MODEL=claude-haiku-4-5
APP_ORIGIN=http://localhost:5173
# Set both for local password protection. Production requires a password >=16 chars.
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=
# Required only when AI_ENABLED=true. Keep this server-side.
ANTHROPIC_API_KEY=
MAX_AI_REQUESTS_PER_DAY=100
MAX_AI_CONCURRENT=2
AI_REQUEST_INTERVAL_MS=3100
