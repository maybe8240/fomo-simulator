# Copy to .env.server for local overrides; npm start and dev:server load it.
# Static mode works locally without Google credentials.
AI_ENABLED=false
CLAUDE_MODEL=claude-haiku-4-5
APP_ORIGIN=http://localhost:5173
# Set both for local password protection. Production requires a password >=16 chars.
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
MAX_AI_REQUESTS_PER_DAY=100
MAX_AI_CONCURRENT=2
AI_REQUEST_INTERVAL_MS=3100
